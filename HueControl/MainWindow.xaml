<Window x:Class="HueControl.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:HueControl.ViewModels"
        xmlns:conv="clr-namespace:HueControl.Converters"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="HueControl" Height="740" Width="1140"
        MinHeight="560" MinWidth="880"
        Icon="Assets/app.ico"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}"
        TextOptions.TextFormattingMode="Ideal"
        FontFamily="Segoe UI">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6"
                            CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:NullToVisibilityConverter x:Key="NullToVis"/>


        <CollectionViewSource x:Key="ScenesView" Source="{Binding Scenes}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="RoomName"/>
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>

        <!-- Tab header styling for the dark theme -->
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Padding="16,10" Margin="0,0,4,0" CornerRadius="8">
                            <ContentPresenter ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface2Brush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Light card -->
        <DataTemplate x:Key="LightTemplate" DataType="{x:Type vm:LightViewModel}">
            <Border Style="{StaticResource CardBorder}" Width="250">
                <StackPanel>
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="18" Height="18" CornerRadius="9"
                                    Background="{Binding ColorBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"
                                       Margin="10,0,0,0" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" MaxWidth="150"/>
                        </StackPanel>
                        <ToggleButton Style="{StaticResource SwitchToggle}"
                                      HorizontalAlignment="Right"
                                      IsChecked="{Binding On, Mode=TwoWay}"/>
                    </Grid>
                    <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="11" Margin="0,6,0,0"/>
                    <Slider Minimum="0" Maximum="100" Margin="0,14,0,0"
                            Value="{Binding Brightness, Mode=TwoWay}"/>
                    <Button Content="Choose colour" Style="{StaticResource FlatButton}"
                            Margin="0,14,0,0" HorizontalAlignment="Stretch"
                            Command="{Binding PickColorCommand}"
                            Visibility="{Binding SupportsColor, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Room selector chip -->
        <DataTemplate x:Key="RoomChipTemplate" DataType="{x:Type vm:GroupViewModel}">
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="11" Height="11" VerticalAlignment="Center">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{DynamicResource BorderBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding AnyOn}" Value="True">
                                    <Setter Property="Fill" Value="{DynamicResource AccentBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <StackPanel Margin="10,0,0,0">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"/>
                    <TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="10" Margin="0,1,0,0"/>
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <!-- Selectable room chip container -->
        <Style x:Key="RoomChipContainer" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" CornerRadius="10" Padding="14,10"
                                Background="{DynamicResource Surface2Brush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                Cursor="Hand">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Scene chip -->
        <DataTemplate x:Key="SceneTemplate" DataType="{x:Type vm:SceneViewModel}">
            <Button Command="{Binding ActivateCommand}" Style="{StaticResource FlatButton}"
                    Margin="6" Padding="12,10" HorizontalContentAlignment="Left">
                <Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                        <Border Width="40" Height="40" CornerRadius="8" Background="{Binding Thumbnail}"
                                Margin="0,0,12,0" VerticalAlignment="Center"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock Text="{Binding RoomName}" Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="10" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <Button Content="&#x2715;" Style="{StaticResource LinkButton}" FontSize="12"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-4,0"
                            ToolTip="Delete scene"
                            Command="{Binding DataContext.DeleteSceneCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}"/>
                </Grid>
            </Button>
        </DataTemplate>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource WindowBorderBrush}" BorderThickness="1">
    <DockPanel LastChildFill="True">
        <!-- ============ Custom title bar ============ -->
        <Grid DockPanel.Dock="Top" Height="40" Background="{DynamicResource TitleBarBrush}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                <Button Style="{StaticResource CaptionButton}" Click="OnToggleMenu" ToolTip="Bridges menu">
                    <StackPanel>
                        <Rectangle Width="16" Height="1.6" Fill="{DynamicResource OnAccentBrush}"/>
                        <Rectangle Width="16" Height="1.6" Fill="{DynamicResource OnAccentBrush}" Margin="0,4,0,0"/>
                        <Rectangle Width="16" Height="1.6" Fill="{DynamicResource OnAccentBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Button>
                <TextBlock Text="HueControl" VerticalAlignment="Center" Margin="6,0,0,0"
                           Foreground="{DynamicResource OnAccentBrush}" FontSize="12" FontWeight="SemiBold"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <!-- Settings (gear) -->
                <Button Style="{StaticResource CaptionButton}" Click="OnOpenSettings" ToolTip="Settings">
                    <Viewbox Width="17" Height="17">
                        <Canvas Width="24" Height="24">
                            <Path Fill="{DynamicResource OnAccentBrush}"
                                  Data="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z"/>
                        </Canvas>
                    </Viewbox>
                </Button>
                <!-- Theme toggle: a white crescent on the accent bar -->
                <Button Style="{StaticResource CaptionButton}" Click="OnToggleTheme" ToolTip="Light / dark theme">
                    <Grid Width="15" Height="15">
                        <Ellipse Fill="{DynamicResource OnAccentBrush}"/>
                        <Ellipse Fill="{DynamicResource TitleBarBrush}" Width="12" Height="12"
                                 HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-3,-3,0"/>
                    </Grid>
                </Button>
                <!-- Minimize: a horizontal line -->
                <Button Style="{StaticResource CaptionButton}" Click="OnMinimize" ToolTip="Minimize">
                    <Rectangle Width="12" Height="1.4" Fill="{DynamicResource OnAccentBrush}"/>
                </Button>
                <!-- Maximize / restore: single square, or offset double square when maximized -->
                <Button Style="{StaticResource CaptionButton}" Click="OnMaximizeRestore" ToolTip="Maximize">
                    <Grid Width="14" Height="14">
                        <Rectangle x:Name="MaxIcon" Width="11" Height="11"
                                   Stroke="{DynamicResource OnAccentBrush}" StrokeThickness="1.3"
                                   Fill="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Grid x:Name="RestoreIcon" Visibility="Collapsed">
                            <Rectangle Width="9" Height="9" Stroke="{DynamicResource OnAccentBrush}"
                                       StrokeThickness="1.3" Fill="Transparent"
                                       HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
                            <Path Data="M2,3 L2,1 L12,1 L12,11 L10,11"
                                  Stroke="{DynamicResource OnAccentBrush}" StrokeThickness="1.3"/>
                        </Grid>
                    </Grid>
                </Button>
                <!-- Close: an X -->
                <Button Style="{StaticResource CloseCaptionButton}" Click="OnClose" ToolTip="Close">
                    <Path Data="M0,0 L11,11 M11,0 L0,11"
                          Stroke="{DynamicResource OnAccentBrush}" StrokeThickness="1.3"/>
                </Button>
            </StackPanel>
        </Grid>

    <Grid>
        <!-- Scrim closes the flyout when clicked -->
        <Rectangle x:Name="Scrim" Panel.ZIndex="5" Fill="#99000000"
                   Visibility="Collapsed" Opacity="0" MouseLeftButtonDown="OnCloseMenu"/>

        <!-- ============ Bridges flyout (slides in from the left) ============ -->
        <Border x:Name="Flyout" Panel.ZIndex="10" HorizontalAlignment="Left" Width="270"
                Background="{DynamicResource SurfaceBrush}">
            <Border.RenderTransform>
                <TranslateTransform x:Name="FlyoutTransform" X="-300"/>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.5" Color="#FF000000"/>
            </Border.Effect>
            <DockPanel Margin="18">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="HueControl" FontSize="22" FontWeight="Bold"/>
                    <TextBlock Text="Philips Hue manager" Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="12" Margin="0,2,0,0"/>
                    <TextBlock Text="HOMES" Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="11" FontWeight="SemiBold" Margin="0,24,0,8"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom">
                    <Button Content="+ Add home" Style="{StaticResource FlatButton}"
                            Margin="0,8,0,0" Command="{Binding AddHomeCommand}"/>
                    <Button Content="+ Add bridge" Style="{StaticResource AccentButton}"
                            Margin="0,8,0,0" Command="{Binding AddBridgeCommand}"/>
                    <Button Content="Remove selected" Style="{StaticResource FlatButton}"
                            Margin="0,8,0,0" Command="{Binding RemoveBridgeCommand}"/>
                    <Separator Margin="0,16" Background="{DynamicResource BorderBrush}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="All on" Style="{StaticResource FlatButton}"
                                Command="{Binding AllOnCommand}"/>
                        <Button Grid.Column="2" Content="All off" Style="{StaticResource FlatButton}"
                                Command="{Binding AllOffCommand}"/>
                    </Grid>
                    <Button Content="Refresh" Style="{StaticResource FlatButton}"
                            Margin="0,8,0,0" Command="{Binding RefreshCommand}"/>
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Margin="0,0,0,12">
                    <ItemsControl ItemsSource="{Binding Homes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,10">
                                    <Grid Margin="4,2,0,4">
                                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextSecondaryBrush}"
                                                   FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Content="Rename" Style="{StaticResource LinkButton}"
                                                    Command="{Binding RenameCommand}"/>
                                            <Button Content="Delete" Style="{StaticResource LinkButton}"
                                                    Command="{Binding DeleteCommand}" Margin="6,0,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding Bridges}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Command="{Binding SelectCommand}" Cursor="Hand" Margin="0,3">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="Bd" CornerRadius="8" Padding="12,10"
                                                                    Background="{DynamicResource Surface2Brush}">
                                                                <StackPanel>
                                                                    <TextBlock x:Name="N" Text="{Binding Name}"
                                                                               FontWeight="SemiBold" FontSize="13"
                                                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                                    <TextBlock x:Name="Ip" Text="{Binding IpAddress}"
                                                                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                                                                </StackPanel>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                                    <Setter TargetName="N" Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
                                                                    <Setter TargetName="Ip" Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
                                                                </DataTrigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ============ Content ============ -->
        <DockPanel Margin="12">
            <!-- Status bar -->
            <Border DockPanel.Dock="Bottom" Background="{DynamicResource SurfaceBrush}"
                    CornerRadius="8" Padding="14,10" Margin="8,4,8,4">
                <Grid>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="Loading…" Foreground="{DynamicResource AccentBrush}"
                               HorizontalAlignment="Right" FontWeight="SemiBold"
                               Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>
                </Grid>
            </Border>

            <TabControl Background="Transparent" BorderThickness="0" Padding="0,12,0,0">
                <!-- Rooms (default): room selector on top, selected room's lights below -->
                <TabItem Header="Rooms">
                    <DockPanel>
                        <!-- Room selector -->
                        <ListBox DockPanel.Dock="Top"
                                 ItemsSource="{Binding Groups}"
                                 SelectedItem="{Binding SelectedGroup, Mode=TwoWay}"
                                 ItemTemplate="{StaticResource RoomChipTemplate}"
                                 ItemContainerStyle="{StaticResource RoomChipContainer}"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                        </ListBox>

                        <!-- Selected room controls -->
                        <Border DockPanel.Dock="Top" Style="{StaticResource CardBorder}"
                                DataContext="{Binding SelectedGroup}"
                                Visibility="{Binding Converter={StaticResource NullToVis}}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding Subtitle}" FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="On" Style="{StaticResource AccentButton}"
                                                Width="72" Command="{Binding TurnOnCommand}"/>
                                        <Button Content="Off" Style="{StaticResource FlatButton}"
                                                Width="72" Margin="8,0,0,0" Command="{Binding TurnOffCommand}"/>
                                    </StackPanel>
                                </Grid>
                                <Slider Grid.Row="1" Minimum="0" Maximum="100" Margin="0,16,0,0"
                                        Value="{Binding Brightness, Mode=TwoWay}"/>
                            </Grid>
                        </Border>

                        <!-- Selected room lights -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding SelectedRoomLights}"
                                          ItemTemplate="{StaticResource LightTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </TabItem>

                <!-- Scenes -->
                <TabItem Header="Scenes">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Source={StaticResource ScenesView}}"
                                      ItemTemplate="{StaticResource SceneTemplate}">
                            <ItemsControl.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="10,18,0,4">
                                                <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="Bold"
                                                           VerticalAlignment="Center"/>
                                                <Button Content="On" Style="{StaticResource AccentButton}"
                                                        Padding="14,4" MinWidth="54" Margin="16,0,0,0"
                                                        Command="{Binding DataContext.RoomOnCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding Name}"/>
                                                <Button Content="Off" Style="{StaticResource FlatButton}"
                                                        Padding="14,4" MinWidth="54" Margin="8,0,0,0"
                                                        Command="{Binding DataContext.RoomOffCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding Name}"/>
                                                <Button Content="+ Scene" Style="{StaticResource FlatButton}"
                                                        Padding="14,4" Margin="8,0,0,0"
                                                        Command="{Binding DataContext.AddSceneCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding Name}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ItemsControl.GroupStyle>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </DockPanel>
    </Grid>
    </DockPanel>
    </Border>
</Window>
