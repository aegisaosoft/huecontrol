<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- WinForms is referenced only for the native color picker dialog. -->
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>HueControl</AssemblyName>
    <RootNamespace>HueControl</RootNamespace>
    <Version>1.0.0</Version>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Embedded so the windows can reference it via Icon="Assets/app.ico". -->
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="HueControl.Tests" />
  </ItemGroup>

</Project>
