<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Dark theme palette -->
    <Color x:Key="BgColor">#FF16161C</Color>
    <SolidColorBrush x:Key="BgBrush" Color="#FF16161C"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FF23232C"/>
    <SolidColorBrush x:Key="Surface2Brush" Color="#FF2E2E3A"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#FF3A3A46"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#FF7C4DFF"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#FF9670FF"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFF0F0F6"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FF9A9AAA"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#FFE05260"/>
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="TitleBarBrush" Color="#FF7C4DFF"/>
    <SolidColorBrush x:Key="WindowBorderBrush" Color="#00000000"/>
</ResourceDictionary>
