<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Light theme palette (white background) -->
    <Color x:Key="BgColor">#FFFFFFFF</Color>
    <SolidColorBrush x:Key="BgBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFF4F4F8"/>
    <SolidColorBrush x:Key="Surface2Brush" Color="#FFE9E9F1"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#FFD7D7E0"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#FF7C4DFF"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#FF6A3FE0"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FF1B1B24"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FF6B6B7B"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#FFE0425A"/>
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="TitleBarBrush" Color="#FF7C4DFF"/>
    <SolidColorBrush x:Key="WindowBorderBrush" Color="#FF7C4DFF"/>
</ResourceDictionary>
